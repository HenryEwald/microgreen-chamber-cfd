/*--------------------------------*- C++ -*----------------------------------*\
| Microgreen chamber CFD -- solvers/relaxation, TRANSIENT                       |
|                                                                              |
| PIMPLE, not SIMPLE. The `...Final` solver entries apply on the LAST outer     |
| corrector of each time step and are tightened there: intermediate outer       |
| iterations are throwaway, the final one sets the answer that gets written.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // ---- Phase 1 transient (pimpleFoam) ---------------------------------
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }

    pFinal
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0;
    }

    // ---- Phase 2b (buoyantPimpleFoam) -----------------------------------
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    p_rghFinal
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }

    // Written out rather than `$U`-expanded: the key is a regex, so there is no
    // entry literally named `U` for the macro to find.
    "(U|k|omega|e|h)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.1;
    }

    "(U|k|omega|e|h)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;
    }

    // ⚠ rhoFinal is NOT optional. Measured 2026-08-15: with only a plain `rho`
    // entry here, buoyantPimpleFoam dies on the FIRST time step with
    //
    //     --> FOAM FATAL IO ERROR
    //     Entry 'rhoFinal' not found in dictionary "system/fvSolution/solvers"
    //
    // PIMPLE looks up `<field>Final` for the last outer corrector of every
    // field it solves. The `"(U|k|omega|e|h)Final"` regex above covers the
    // momentum/turbulence/energy set and `p_rghFinal` is written out, but `rho`
    // was a bare entry and matched neither -- so the gap was invisible until the
    // buoyant solver was actually run. Phase 1 never touches it: pimpleFoam is
    // incompressible and never solves rho at all.
    //
    // Written as a regex so the pair cannot drift apart again. relTol 0.01 is
    // harmless on the final corrector here -- rho is an algebraic update from
    // the thermo, not a transported field -- but keep both entries present.
    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    // Mean age of air. See the steady fvSolution -- mandatory, and the solver
    // dies at the first write without it, not at startup.
    age
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0;
    }
}

PIMPLE
{
    // A CAP, not a target -- residualControl below exits as soon as the time
    // step is converged. Measured 2026-08-14 at m1/maxCo 6: mean 11.1 outer
    // iterations, range 8-17, so 20 leaves headroom without ever being reached.
    //
    // ⚠ nOuterCorrectors 2 with NO residualControl DIVERGES. That was the
    // configuration that crashed with an FPE at t = 0.31 s: k and omega reached
    // 1e105/1e55 after 3295 `bounding k` messages. Root cause was that the outer
    // loop never contracted -- p's initial residual on outer iteration 2 was the
    // SAME as on iteration 1 (ratio 0.74-1.08 where a converging loop is << 1),
    // so no time step was ever converged and the unrelaxed `...Final` correctors
    // applied that unconverged update at Co ~ 6. It ignited in the shear layer
    // above the outlet-bound flow and climbed into the hood.
    //
    // The steady solver survives the same mesh and BCs only because SIMPLE
    // relaxes p by 0.3 every iteration. A transient run deliberately drops that
    // relaxation for time accuracy, so the outer loop MUST do the converging
    // instead. Do not "simplify" this back to a small fixed count.
    nOuterCorrectors    20;

    // nCorrectors 1, NOT 2. The total pressure solves per time step is
    // nOuterCorrectors * nCorrectors * (1 + nNonOrthogonalCorrectors), so at
    // nCorrectors 2 that is EIGHT GAMG solves per step -- measured at 2.28 s/step
    // on m1/8 ranks, which projects to ~30 h for a 6.6-tau run.
    //
    // It was also wasted work: measured 2026-08-14, the first corrector already
    // left `time step continuity errors: sum local = 2.6e-4` and the second
    // drove it to 6.7e-8 -- six orders below anything that matters, every step.
    // The outer corrector loop is what converges the time step; a second inner
    // corrector just over-solves an equation that is about to be re-formed.
    nCorrectors         1;

    nNonOrthogonalCorrectors 1;    // matches the steady case; max non-orth 63.6

    // This is what makes the run stable -- see the nOuterCorrectors note above.
    // It is also what makes it affordable: without an early exit, every step
    // would burn all 20 outer iterations instead of the measured mean of 11.
    residualControl
    {
        p           { tolerance 1e-4; relTol 0; }
        U           { tolerance 1e-5; relTol 0; }
        "(k|omega)" { tolerance 1e-5; relTol 0; }
    }

    pRefCell        0;
    pRefValue       0;
    pRefPoint       (0.0613 0.0917 0.0613);   // Phase 2b only
}

relaxationFactors
{
    // Relax the intermediate outer correctors, then take the final one
    // unrelaxed so the time step is solved to its own equations rather than to
    // a relaxed approximation of them. Relaxing `...Final` is a classic way to
    // get a smooth, stable, time-inaccurate answer.
    fields
    {
        p               0.7;
        pFinal          1;
        p_rgh           0.7;
        p_rghFinal      1;
    }
    equations
    {
        U               0.7;
        UFinal          1;
        "(k|omega)"     0.7;
        "(k|omega)Final" 1;
        "(h|e)"         0.7;
        "(h|e)Final"    1;
    }
}

// ************************************************************************* //
