#!/bin/sh
cd "$(dirname "$0")" || exit 1

# CLAUDE.md 2 -- ~/.bashrc does not source OpenFOAM. Every script activates it.
#
# NOTE: source etc/bashrc, NOT /usr/bin/openfoam2606. The latter is
# `exec .../etc/openfoam`, which REPLACES this shell with an interactive
# OpenFOAM session -- sourcing it silently discards the rest of the script.
# shellcheck disable=SC1091
. /usr/lib/openfoam/openfoam2606/etc/bashrc

# shellcheck disable=SC1091
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

APP=$(getApplication)

# CLAUDE.md 3.2 -- pin to physical cores. RunFunctions' runParallel calls
# `mpirun --oversubscribe` with no binding at all; unpinned ranks get migrated
# across CCDs and lose the L3 they warmed, which is the whole point of the
# V-cache die. Use this instead of runParallel.
runPinned()
{
    _np=$1 ; _app=$2 ; shift 2
    _log="log.$_app"
    [ -f "$_log" ] && { echo "$_app already run: remove $_log to re-run"; return 0; }
    echo "Running $_app ($_np ranks, pinned to cores 0-$((_np - 1))) on $PWD"
    mpirun --cpu-set "0-$((_np - 1))" --bind-to core -np "$_np" \
        "$_app" "$@" -parallel </dev/null > "$_log" 2>&1
}

# ---------------------------------------------------------------------------
# Geometry. Generated analytically -- there is no CAD input (CLAUDE.md 6.1).
# ---------------------------------------------------------------------------
if [ ! -f constant/triSurface/chamber.stl ]; then
    echo "== generating geometry"
    python3 ../../scripts/make_geometry.py --case . --verify > log.makeGeometry 2>&1 \
        || { echo "geometry generation FAILED, see log.makeGeometry"; exit 1; }
    cat log.makeGeometry
fi

# ---------------------------------------------------------------------------
# Mesh
# ---------------------------------------------------------------------------
runApplication blockMesh
runApplication surfaceFeatureExtract

NPROCS=$(foamDictionary -entry numberOfSubdomains -value system/decomposeParDict)

# Background cell count, straight from the resolution entries. Do NOT try to
# parse the `blocks` entry -- the leading `hex (0 1 2 3 4 5 6 7)` vertex list
# makes any positional field extraction pick up the vertex labels instead.
NX=$(foamDictionary -entry nx -value system/blockMeshDict)
NY=$(foamDictionary -entry ny -value system/blockMeshDict)
NZ=$(foamDictionary -entry nz -value system/blockMeshDict)
NCELLS=$((NX * NY * NZ))

# CLAUDE.md 3.2 -- keep >= 50 k cells/rank. m1 is too small to decompose.
if [ "$NCELLS" -lt 200000 ]; then
    echo "== small mesh (${NCELLS} background cells): meshing serial"
    runApplication snappyHexMesh -overwrite
else
    echo "== ${NCELLS} background cells: meshing on $NPROCS ranks"
    # -no-fields: there is no 0/ yet (restore0Dir runs after the mesh is built),
    # so there is nothing to decompose but the mesh.
    runApplication -s mesh decomposePar -no-fields
    runPinned "$NPROCS" snappyHexMesh -overwrite
    runApplication reconstructParMesh -constant
    rm -rf processor*
fi

runApplication topoSet

# CLAUDE.md 3.3 -- 10-25 % gain for a bandwidth-limited code, and it matters
# MORE than usual on the V-cache die. Always before decomposePar.
runApplication renumberMesh -overwrite

runApplication checkMesh -allTopology -allGeometry

# CLAUDE.md 9.1 -- a mesh that fails checkMesh is not a mesh. Stop here and read
# the log rather than solving on it and discovering the problem in the results.
if grep -q "\*\*\*" log.checkMesh; then
    echo
    echo "!! checkMesh reported FAILURES -- see log.checkMesh"
    echo "!! Fix the mesh or justify every failure explicitly (CLAUDE.md 9.1)."
    echo "!! Not solving."
    exit 1
fi

# ---------------------------------------------------------------------------
# Solve
# ---------------------------------------------------------------------------
# CLAUDE.md 1.4 -- 0.orig is the source of truth. 0/ is a copy made here.
restore0Dir

if [ "$NCELLS" -lt 200000 ]; then
    runApplication "$APP"
else
    # -force: the mesh changed under snappy and processor*/ was removed above.
    # Separate log suffix, or runApplication would see log.decomposePar from the
    # meshing stage and silently skip this -- leaving no fields to solve on.
    runApplication -s fields decomposePar -force
    runPinned "$NPROCS" "$APP"
    runApplication reconstructPar -latestTime
fi

echo
echo "== done. Before calling this a result, check CLAUDE.md 9:"
echo "   1. checkMesh passed                    log.checkMesh"
echo "   2. residuals dropped >=3-4 orders AND flattened"
echo "   3. global continuity error small, not growing"
echo "   4. inlet + outlet flux ~ 0             postProcessing/inletFlux, outletFlux"
echo "   5. monitored quantities flat           postProcessing/trayPlane"
echo "   6. mesh independence demonstrated"
echo "   7. steady assumption validated"
echo
echo "   foamLog log.$APP     # -> residual series for plotting"
