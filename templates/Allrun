#!/bin/sh
cd "$(dirname "$0")" || exit 1

# CLAUDE.md 2 -- ~/.bashrc does not source OpenFOAM. Every script activates it.
#
# NOTE: source etc/bashrc, NOT /usr/bin/openfoam2606. The latter is
# `exec .../etc/openfoam`, which REPLACES this shell with an interactive
# OpenFOAM session -- sourcing it silently discards the rest of the script.
# shellcheck disable=SC1091
. /usr/lib/openfoam/openfoam2606/etc/bashrc

# shellcheck disable=SC1091
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

APP=$(getApplication)

# CLAUDE.md 3.2 -- pin to physical cores. RunFunctions' runParallel calls
# `mpirun --oversubscribe` with no binding at all; unpinned ranks get migrated
# across CCDs and lose the L3 they warmed, which is the whole point of the
# V-cache die. Use this instead of runParallel.
runPinned()
{
    _np=$1 ; _app=$2 ; shift 2
    _log="log.$_app"
    [ -f "$_log" ] && { echo "$_app already run: remove $_log to re-run"; return 0; }
    echo "Running $_app ($_np ranks, pinned to cores 0-$((_np - 1))) on $PWD"
    mpirun --cpu-set "0-$((_np - 1))" --bind-to core -np "$_np" \
        "$_app" "$@" -parallel </dev/null > "$_log" 2>&1
}

# ---------------------------------------------------------------------------
# Geometry. Generated analytically -- there is no CAD input (CLAUDE.md 6.1).
# ---------------------------------------------------------------------------
if [ ! -f constant/triSurface/chamber.stl ]; then
    echo "== generating geometry"
    python3 ../../scripts/make_geometry.py --case . --verify > log.makeGeometry 2>&1 \
        || { echo "geometry generation FAILED, see log.makeGeometry"; exit 1; }
    cat log.makeGeometry
fi

# ---------------------------------------------------------------------------
# Mesh
# ---------------------------------------------------------------------------
runApplication blockMesh
runApplication surfaceFeatureExtract

NPROCS=$(foamDictionary -entry numberOfSubdomains -value system/decomposeParDict)

# Background cell count, straight from the resolution entries. Do NOT try to
# parse the `blocks` entry -- the leading `hex (0 1 2 3 4 5 6 7)` vertex list
# makes any positional field extraction pick up the vertex labels instead.
NX=$(foamDictionary -entry nx -value system/blockMeshDict)
NY=$(foamDictionary -entry ny -value system/blockMeshDict)
NZ=$(foamDictionary -entry nz -value system/blockMeshDict)
NCELLS=$((NX * NY * NZ))

# MESHING only. This is the one decision that genuinely has to use the background
# count, because it is taken before there is a mesh to count. snappy's own cost
# tracks the background block closely enough for the purpose.
#
# Do NOT reuse it for the solve -- see the MESHCELLS block below.
if [ "$NCELLS" -lt 200000 ]; then
    echo "== small mesh (${NCELLS} background cells): meshing serial"
    runApplication snappyHexMesh -overwrite
else
    echo "== ${NCELLS} background cells: meshing on $NPROCS ranks"
    # -no-fields: there is no 0/ yet (restore0Dir runs after the mesh is built),
    # so there is nothing to decompose but the mesh.
    runApplication -s mesh decomposePar -no-fields
    runPinned "$NPROCS" snappyHexMesh -overwrite
    runApplication reconstructParMesh -constant
    rm -rf processor*
fi

runApplication topoSet

# CLAUDE.md 3.3 -- 10-25 % gain for a bandwidth-limited code, and it matters
# MORE than usual on the V-cache die. Always before decomposePar.
runApplication renumberMesh -overwrite

# Two passes, on purpose.
#
#   log.checkMesh          the STANDARD checks. This is the acceptance gate.
#   log.checkMesh.extra    -allTopology -allGeometry, for the report.
#
# The extra pass is informational only, because on ANY snappy mesh with layers
# it reports `***Concave cells (using face planes)` -- 2 % of cells at m1, 1.3 %
# at m2 -- and gating on a bare `***` grep therefore aborts every single run
# before it solves. Concavity by face planes is a property of layer cells and
# refinement transitions, not a defect; the standard checks are the bar
# CLAUDE.md 7 actually names (non-orthogonality < 65, skewness < 4).
runApplication checkMesh
runApplication -s extra checkMesh -allTopology -allGeometry

# CLAUDE.md 9.1 -- a mesh that fails checkMesh is not a mesh. Stop here and read
# the log rather than solving on it and discovering the problem in the results.
if ! grep -q "^Mesh OK" log.checkMesh; then
    echo
    echo "!! checkMesh FAILED -- see log.checkMesh"
    echo "!! Fix the mesh or justify every failure explicitly (CLAUDE.md 9.1)."
    echo "!! Not solving."
    exit 1
fi

# Non-orthogonality drives nNonOrthogonalCorrectors (CLAUDE.md 7). Surface it
# here so it is not something you have to remember to go and look up.
echo "== mesh accepted:"
grep -E "cells:|non-orthogonality Max|Max skewness|Total volume" log.checkMesh.extra \
    | sed 's/^/   /'
echo "   (V_air should be 2.5302e-3 m3 -- CLAUDE.md 6.1)"

# ---------------------------------------------------------------------------
# Solve
# ---------------------------------------------------------------------------
# How many cells are there ACTUALLY? Not the background count.
#
# The two differ by ~5x -- CLAUDE.md 7 records m1 as 99 k background cells and
# 1.07 M real ones, because surface-driven refinement dominates. Sizing the
# SOLVE off the background count therefore put a 1.07 M-cell case on a single
# core: ~4 hours at the measured 3.6 s/iteration, against well under an hour on
# 8 ranks. CLAUDE.md 3.2 sizes ranks by the FINAL cell count, and by this point
# checkMesh has already reported it, so use that.
MESHCELLS=$(sed -n 's/^ *cells: *\([0-9][0-9]*\).*/\1/p' log.checkMesh | head -1)
[ -n "$MESHCELLS" ] || MESHCELLS=$NCELLS   # fall back rather than divide by nothing

# The CLAUDE.md 3.2 floor, stated as the rule rather than as a magic number:
# below ~50 k cells/rank halo exchange dominates and scaling inverts. With
# NPROCS from decomposeParDict this adapts on its own if the rank count changes.
MINPERRANK=50000

# HALVE the rank count until the floor is met, rather than falling straight from
# $NPROCS to serial. The all-or-nothing version threw away most of the machine on
# any mesh between 50 k and 400 k cells: measured 2026-08-14, the 380 k-cell m0
# rung failed the 8-rank test (needs 400 k) and went SERIAL at ~1 s/iteration,
# when 4 ranks gives it 95 k cells/rank -- comfortably above the floor, and the
# CLAUDE.md 3.2 tier table asks for exactly 4 ranks below 0.5 M anyway.
#
# Halving, not $((MESHCELLS / MINPERRANK)), so the count stays a power of two and
# keeps landing on whole CCD0 core groups (CLAUDE.md 3.2).
SOLVERANKS=$NPROCS
while [ "$SOLVERANKS" -gt 1 ] && [ "$MESHCELLS" -lt $((SOLVERANKS * MINPERRANK)) ]; do
    SOLVERANKS=$((SOLVERANKS / 2))
done

if [ "$SOLVERANKS" -le 1 ]; then
    echo "== ${MESHCELLS} cells: below ${MINPERRANK} even on 2 ranks, solving serial"
else
    echo "== ${MESHCELLS} cells: solving on $SOLVERANKS ranks ($((MESHCELLS / SOLVERANKS)) cells/rank)"
    [ "$SOLVERANKS" -ne "$NPROCS" ] && \
        echo "   (decomposeParDict says $NPROCS; reduced to hold >=${MINPERRANK} cells/rank)"
    # decomposePar reads this, so it has to actually change -- not just the label.
    foamDictionary -entry numberOfSubdomains -set "$SOLVERANKS" system/decomposeParDict > /dev/null
fi

# CLAUDE.md 1.4 -- 0.orig is the source of truth. 0/ is a copy made here.
restore0Dir

solve_ok=1
if [ "$SOLVERANKS" -le 1 ]; then
    runApplication "$APP" || solve_ok=0
else
    # -force: the mesh changed under snappy and processor*/ was removed above.
    # Separate log suffix, or runApplication would see log.decomposePar from the
    # meshing stage and silently skip this -- leaving no fields to solve on.
    runApplication -s fields decomposePar -force
    runPinned "$SOLVERANKS" "$APP" || solve_ok=0

    # A steady run only has one meaningful time; a transient one has a history,
    # and -latestTime would silently throw it away. Match the solver by name --
    # NOT a `*impleFoam` glob, which also matches simpleFoam.
    case "$APP" in
        pimpleFoam|buoyantPimpleFoam) runApplication reconstructPar ;;
        *)                            runApplication reconstructPar -latestTime ;;
    esac
fi

# runApplication does not propagate the solver's exit status, so without this
# a crashed solve still prints the cheerful checklist below and looks like a
# success. A FATAL IO ERROR in a function object dies on iteration 1 and is
# very easy to miss.
if [ "$solve_ok" -eq 0 ] || ! grep -q "^End" "log.$APP"; then
    echo
    echo "!! $APP did NOT finish cleanly -- see log.$APP"
    tail -20 "log.$APP" | sed 's/^/   /'
    exit 1
fi

echo
echo "== done. Before calling this a result, check CLAUDE.md 9:"
echo "   1. checkMesh passed                    log.checkMesh"
echo "   2. residuals dropped >=3-4 orders AND flattened"
echo "   3. global continuity error small, not growing"
echo "   4. inlet + outlet flux ~ 0             postProcessing/inletFlux, outletFlux"
echo "   5. monitored quantities flat           postProcessing/trayPlane"
echo "   6. mesh independence demonstrated"
echo "   7. steady assumption validated"
echo
echo "   foamLog log.$APP     # -> residual series for plotting"
