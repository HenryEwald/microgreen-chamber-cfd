/*--------------------------------*- C++ -*----------------------------------*\
| Microgreen chamber CFD -- internal flow, meshing the chamber void            |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    chamber.stl
    {
        type        triSurfaceMesh;
        name        chamber;
        regions
        {
            floor   { name floor;  }
            walls   { name walls;  }
            hood    { name hood;   }
            inlet   { name inlet;  }
            outlet  { name outlet; }
        }
    }

    tray.stl
    {
        type        triSurfaceMesh;
        name        tray;
        regions
        {
            tray    { name tray; }
        }
    }

    // diffuser.stl is INSERTED HERE by generate_case.sh --diffuser <tilt>, and
    // is deliberately absent from the template. snappy fails hard on a
    // triSurfaceMesh whose file does not exist, and the control arm of the
    // diffuser screen has no diffuser.stl at all, so the entry cannot be
    // unconditional. Keeping the template as the no-diffuser case also means
    // every pre-2026-08-16 case still regenerates unchanged.

    // Volume refinement around the two port jets. The jet sets the entire flow
    // field (CLAUDE.md 6.2), so it is resolved well past the opening.
    inletJet
    {
        type        searchableBox;
        min         (0.040 -0.001 0.046);
        max         (0.080  0.050 0.088);
    }
    outletJet
    {
        type        searchableBox;
        min         (0.040 0.136 0.046);
        max         (0.080 0.188 0.088);
    }

    // The INLET SHEAR LAYER. Enabled only by `generate_case.sh --jetRefine`,
    // which raises this one region a level above inletJet -- see the note in
    // refinementRegions below for why it is opt-in rather than default.
    //
    // The ports are plain cutouts with a top-hat inlet BC (CLAUDE.md 6.1/6.2),
    // so the shear layer starts at ZERO thickness on the lip and grows as
    // delta ~ sqrt(nu*x/U). It is resolved once delta >= one cell, at
    // x_res = h^2 * U / nu. Measured at Q = 1.25 m3/h (U = 1.105 m/s):
    //
    //   mesh   h at port   x_res     of the 186.7 mm inlet->outlet path
    //   m0      1.667 mm   202.5 mm  NEVER resolved in-domain
    //   m1      0.833 mm    50.6 mm  resolved over the last 73 %
    //   m2      0.417 mm    12.7 mm  resolved over the last 93 %
    //
    // Only the INLET gets this. An outlet is a sink -- potential-flow-like,
    // drawing near-isotropically with no directional reach and no shear layer
    // worth resolving (CLAUDE.md 6.2). Refining it would double the cost for
    // nothing.
    //
    // Box covers the first ~26 mm of jet, where the layer is thinnest and the
    // resolution demand is highest. It hugs the port (x 50-70, z 56.7-76.7 mm)
    // with ~4 mm of margin so the level transition has somewhere to sit.
    jetShear
    {
        type        searchableBox;
        min         (0.046 -0.001 0.052);
        max         (0.074  0.026 0.081);
    }

    // REMOVED 2026-08-16 -- traySlotLeft / traySlotRight.
    //
    // The tray is now FLUSH with all four chamber walls and fills the entire
    // internal floor footprint (design change, CLAUDE.md 6.1). There are no
    // 2.5 mm side slots and no end gaps left to resolve, so the two thin
    // refinement boxes that existed solely to keep them open are gone, along
    // with the level-3 override generate_case.sh used to apply at m0.
    //
    // Kept for the record, because it is the most useful measurement this
    // project made about where cells actually live: the A/B at m1 that replaced
    // one large box with these two thin ones saved 5,273 cells -- 0.49 %, not
    // the "substantial" cut CLAUDE.md 7 predicted. The single box looked
    // expensive because it was geometrically large, but most of its volume sat
    // INSIDE the tray solid where snappy deletes the cells at subsetting
    // anyway. Refining cells that are about to be discarded is nearly free.
    //
    // The lesson survives the geometry change: refinementRegions is NOT where
    // the cells are. At m1 they are in refinementSurfaces (+531 k) and
    // addLayers (+302 k). Those are the only two real levers, and both trade
    // against wall-resolved physics, so they are a scientific call rather than
    // free optimisation.
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      20000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    // ⚠ tray.eMesh is DELIBERATELY ABSENT (2026-08-16). Do not add it back.
    //
    // The flush tray is written 1 mm oversize so its sides and base are buried
    // in the wall/floor material rather than coplanar with them
    // (make_geometry.py). That means EVERY edge of tray.stl lies inside solid,
    // outside the fluid domain -- there is no tray feature edge left to snap to.
    //
    // Listing it here does active harm. Measured at m0 with the entry present:
    // explicit feature snapping pulled mesh points out onto the buried edges,
    // leaving a thin skirt of cells 1 mm PAST the chamber walls. Both the tray
    // and walls patches came back with bounding boxes spanning
    // x = -0.001 .. 0.121 against an internal width of 0 .. 0.120, and total
    // volume was 2.3300881e-3 m3 against V_air 2.3296e-3 -- a 0.49 mL EXCESS,
    // which is exactly perimeter(0.6133 m) x 1 mm x ~0.8 mm of skirt.
    //
    // The real feature -- the concave corner where the tray top meets each wall
    // -- is the intersection of two refinementSurfaces, which snappy resolves
    // from the surfaces themselves. It does not need, and must not get, an
    // eMesh entry.
    features
    (
        { file "chamber.eMesh"; level 2; }
    );

    refinementSurfaces
    {
        chamber
        {
            level       (1 1);
            regions
            {
                // Curved -- needs the extra level to stay smooth.
                hood    { level (2 2); patchInfo { type wall; } }
                floor   { level (1 1); patchInfo { type wall; } }
                walls   { level (1 1); patchInfo { type wall; } }
                // The jet openings. Level 2 => 48 cells across a Oe 20 port at
                // m2, and twice that since the port went to Oe 40 (2026-08-16).
                inlet   { level (2 2); patchInfo { type patch; } }
                outlet  { level (2 2); patchInfo { type patch; } }
            }
        }

        tray
        {
            level       (2 2);
            regions
            {
                tray    { level (2 2); patchInfo { type wall; } }
            }
        }

        // The `diffuser` refinementSurface is INSERTED HERE by generate_case.sh
        // at level 4, alongside the geometry entry above. Level 4 is 0.417 mm
        // at m0, i.e. ~3.6 cells across a 1.5 mm vane -- the minimum that
        // represents a plate as a plate rather than as a rough wall.
    }

    resolveFeatureAngle     30;

    refinementRegions
    {
        inletJet      { mode inside; levels ((1e15 2)); }
        outletJet     { mode inside; levels ((1e15 2)); }
        // traySlotLeft/Right removed 2026-08-16 -- the slots no longer exist.

        // jetShear is added here by `generate_case.sh --jetRefine`, at one level
        // above inletJet. It is OPT-IN, not default, for two reasons:
        //
        //  1. It changes the mesh the Phase-1 independence study was built on
        //     (validation/mesh_independence.md), which would silently invalidate it.
        //  2. It is only needed for the LAMINAR arm. kOmegaSST does not need it --
        //     measured 2026-08-14, its nut is 5x the molecular viscosity, which
        //     thickens the shear layer by sqrt(6) = 2.45x and makes it resolvable
        //     on cells that cannot resolve the real one. Turning it on for both
        //     arms would be wasted cells on the RANS side; turning it on for only
        //     the laminar arm would confound the model comparison. So it is an
        //     explicit choice the operator makes and records in NOTES.md.
        //
        // Cost/benefit at m1: +~28 % cells buys the shear-layer resolution of m2,
        // which costs +458 %. That is the efficient way to get it.
    }

    // Inside the chamber void, deliberately off every symmetry plane.
    // z = 61.3 mm is above the tray top (25 mm) and below the hood spring (96.7 mm).
    locationInMesh          (0.0613 0.0917 0.0613);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;

    nFeatureSnapIter    15;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;

    layers
    {
        // The wall boundary layer IS the physics for a short canopy
        // (CLAUDE.md 7), so layers matter on every no-slip surface.
        floor   { nSurfaceLayers 4; }
        walls   { nSurfaceLayers 4; }
        hood    { nSurfaceLayers 4; }

        // Tray: 4 layers, MATCHING THE WALLS, as of 2026-08-16.
        //
        // It carried nSurfaceLayers 0 for one reason only: layer insertion
        // inside the ~6-cell-wide side slots either failed outright or wrecked
        // the cell quality there. The flush tray has no slots -- its top is a
        // single flat horizontal plane spanning the whole floor footprint,
        // which is the easiest surface in the case to layer.
        //
        // This is what makes tray wall shear reportable for the first time.
        // CLAUDE.md's standing caveat ("Tray has no boundary layers -- do not
        // report tray wall shear") is lifted for flush-tray cases and ONLY
        // those; every run generated before this date is still unlayered there.
        //
        // Watch the tray/wall junction in checkMesh: the layer stacks on the
        // tray top and on the four walls now meet at a concave corner, which is
        // where layer collapse shows up first. `floor` gets no layers in
        // practice -- it has no fluid faces at all now (see make_geometry.py).
        tray    { nSurfaceLayers 4; }

        // The `diffuser` layer entry is INSERTED HERE by generate_case.sh, at
        // nSurfaceLayers 0. A 1.5 mm vane resolved at 0.417 mm cannot carry a
        // 4-layer stack on both faces -- the two stacks would meet in the middle
        // and collapse. This is the same reason the tray carried 0 layers until
        // it went flush, and it carries the same consequence: VANE WALL SHEAR IS
        // NOT REPORTABLE. It is not needed; the vanes are a flow-turning device,
        // not a heat-transfer surface.
    }

    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        0.1;

    nGrow               0;
    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        20;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance  1e-6;

// ************************************************************************* //
