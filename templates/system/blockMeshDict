/*--------------------------------*- C++ -*----------------------------------*\
| Microgreen chamber CFD -- background block for snappyHexMesh                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Resolution. Set by scripts/generate_case.sh -- do not hand-edit in a run.
//   m0  19  29  23   base 20/3 mm    ~13 k background   ~0.19 M final (est)
//   m1  38  58  45   base 10/3 mm    ~99 k background    1.07 M final (MEASURED)
//   m2  76 116  90   base  5/3 mm   ~793 k background    5.97 M final (MEASURED)
//   m3 152 232 180   base  5/6 mm   ~6.3 M background     ~33 M  -- NOT BUILDABLE
//
// The independence ladder is m0/m1/m2, running DOWNWARD. m3 exceeds the 20 M
// maxGlobalCells cap in snappyHexMeshDict, so snappy would stop refining
// silently and return a mesh that is not level 3 (CLAUDE.md 7).
//
// Growth m1 -> m2 is 5.6x, not 8x: refinement is SURFACE-driven, so it scales
// with area rather than volume. Measured m1 breakdown, from log.snappyHexMesh:
//   background            99 k
//   + feature refinement  130 k
//   + surface refinement  661 k   <- 531 k, the dominant term
//   + shell refinement    960 k   <- the refinementRegions boxes
//   - subsetting          768 k   (drop everything outside the chamber)
//   + LAYERS            1,070 k   <- +302 k, i.e. +39 % of the pre-layer mesh
// Cell count is therefore governed by refinementSurfaces and addLayersControls.
// The refinementRegions are NOT where the cells are (see snappyHexMeshDict).
nx  76;
ny  116;
nz  90;

// Background box = internal chamber bounding box + exactly one m1 cell of margin
// on every side. Chosen so every span is an integer multiple of 10/3 mm at all
// three levels -- no sliver cells, no re-derivation when the level changes.
//   x span 0.1266667 m = 38 * 10/3 mm      (chamber 0      -> 0.120000)
//   y span 0.1933333 m = 58 * 10/3 mm      (chamber 0      -> 0.186667)
//   z span 0.1500000 m = 45 * 10/3 mm      (chamber 0      -> 0.143334)
xmin  -0.0033333;   xmax   0.1233333;
ymin  -0.0033333;   ymax   0.1900000;
zmin  -0.0033333;   zmax   0.1466667;

vertices
(
    ($xmin $ymin $zmin)
    ($xmax $ymin $zmin)
    ($xmax $ymax $zmin)
    ($xmin $ymax $zmin)
    ($xmin $ymin $zmax)
    ($xmax $ymin $zmax)
    ($xmax $ymax $zmax)
    ($xmin $ymax $zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges
(
);

// All background faces should be consumed by snappyHexMesh. If this patch still
// has faces after snapping, the geometry is not closed or locationInMesh is in
// the wrong region -- do not proceed, fix the STL.
boundary
(
    background
    {
        type    patch;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
            (0 1 5 4)
            (2 3 7 6)
            (0 4 7 3)
            (1 2 6 5)
        );
    }
);

// ************************************************************************* //
