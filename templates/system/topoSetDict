/*--------------------------------*- C++ -*----------------------------------*\
| Microgreen chamber CFD -- cell zones for post-processing                      |
|                                                                              |
| Run AFTER snappyHexMesh, BEFORE the solver. Creates the zones that            |
| functions/trayMetrics reports on.                                             |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // The canopy volume: directly over the tray, from its surface (z = 25 mm)
    // up to a mature canopy top (z = 75 mm). This is where "does air reach the
    // whole tray" is actually answered.
    {
        name        canopyZoneCells;
        type        cellSet;
        action      new;
        source      boxToCell;
        // FULL internal footprint as of 2026-08-16. The tray is flush with all
        // four walls and covers the whole floor, so the growing area is the
        // entire 120 x 186.667 mm cross-section, not the old inset
        // 115 x 125 mm box. z is unchanged: tray top (25 mm) to a mature
        // 50 mm canopy (75 mm).
        //
        // Bounds run 1 mm past the walls deliberately -- boxToCell takes cell
        // CENTRES, so a box ending exactly on the wall drops the near-wall
        // cells and biases the zone away from precisely the region where the
        // canopy meets the wall.
        box         (-0.001 -0.001 0.025) (0.121 0.187667 0.075);
    }
    {
        name        canopyZone;
        type        cellZoneSet;
        action      new;
        source      setToCellZone;
        set         canopyZoneCells;
    }

    // The hood volume, everything above the box top. Expected to be the worst
    // ventilated region in the chamber (CLAUDE.md 6.1) -- this zone is how that
    // gets measured rather than asserted.
    {
        name        hoodZoneCells;
        type        cellSet;
        action      new;
        source      boxToCell;
        box         (-0.01 -0.01 0.096667) (0.13 0.20 0.15);
    }
    {
        name        hoodZone;
        type        cellZoneSet;
        action      new;
        source      setToCellZone;
        set         hoodZoneCells;
    }
);

