/*--------------------------------*- C++ -*----------------------------------*\
| Mass balance at the ports -- CLAUDE.md 9.4                                   |
|                                                                              |
| "inlet flux + outlet flux ~ 0. This catches bad BC pairings faster than       |
|  anything else." Watch log.solve / postProcessing/ for these two summing to   |
|  zero. If they do not, stop and fix the BCs -- nothing downstream is valid.   |
|                                                                              |
| Target at Q = 5 m3/h:  |phi| = 1.3889e-3 m3/s (simpleFoam, volumetric)        |
|                        |phi| = 1.667e-3 kg/s  (buoyantSimpleFoam, mass)       |
\*---------------------------------------------------------------------------*/

inletFlux
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    timeStep;
    writeInterval   20;
    log             true;
    writeFields     false;
    regionType      patch;
    name            inlet;
    operation       sum;
    fields          (phi);
}

outletFlux
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    timeStep;
    writeInterval   20;
    log             true;
    writeFields     false;
    regionType      patch;
    name            outlet;
    operation       sum;
    fields          (phi);
}

// Area-averaged outlet velocity -- sanity check against Q / A_port.
outletU
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    timeStep;
    writeInterval   20;
    log             false;
    writeFields     false;
    regionType      patch;
    name            outlet;
    operation       areaAverage;
    fields          (U);
}

// How much air actually goes down the 2.5 mm tray side slots (CLAUDE.md 7)?
// This is a RESULT, not an assumption. If it comes out below ~1 % of Q, the
// level-2 slot refinement can be dropped at m3 and the study gets cheaper.
//
// NOT `sum` of `phi`, as inletFlux/outletFlux above do. Those are patches, which
// carry the face flux directly; this is a sampledSurface, which INTERPOLATES
// VOLUME fields onto a cut plane and has no access to the surfaceScalarField phi
// -- asking for it gets only "Requested field phi not found in database and not
// processed" and the slot split silently never gets measured. `areaNormalIntegrate`
// on U gives sum(U & Sf) = the volumetric flow through the plane [m3/s], which is
// the same quantity. It is reported in the x-component of the returned vector.
//
// Verified: the sample picks up 868 faces / 1.2519e-4 m2 at m1, i.e. exactly the
// two 2.5 x 25 mm slots (1.25e-4 m2) -- the bounds are already right, because the
// tray interior is not meshed, so the only fluid below z = 25 mm at mid-depth IS
// the slots.
//
// Compare against |phi| at the ports: 1.3889e-3 m3/s at Q = 5 m3/h.
traySlotFlux
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
    log             true;
    writeFields     false;
    regionType      sampledSurface;
    name            slotPlane;
    sampledSurfaceDict
    {
        type        plane;
        planeType   pointAndNormal;
        pointAndNormalDict
        {
            point   (0 0.0933 0.0125);   // mid-depth, mid-slot-height
            normal  (0 1 0);
        }
        // restrict to the two slots: x outside the tray footprint, z below its top
        bounds      (-1 -1 -1) (1 1 0.025);
        interpolate true;
    }
    operation       areaNormalIntegrate;
    fields          (U);
}

